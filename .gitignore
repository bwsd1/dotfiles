.mbsyncrc
/mutt/muttrc
*.swp
.claude/settings.local.json

# ~/.gitignore_global ignores extensionless files by default ("*" plus
# "!*.*"). Every script in bin/ is extensionless, so without this a newly
# added one is silently invisible to git status while still being picked
# up and installed by $(wildcard bin/*) in the Makefile.
!/bin/*
