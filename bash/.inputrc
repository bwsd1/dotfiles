set bell-style none

set input-meta on
set output-meta on

set completion-query-items 2048

set bind-tty-special-chars off

# supress output of control characters
set echo-control-characters off

set show-all-if-ambiguous on

set editing-mode vi
$if mode=vi
    # vi-unix-word-rubout, the vi default for Control-w, will not delete
    # text from before where the current insert began, so after moving
    # the cursor it does nothing. unix-word-rubout always deletes the
    # whitespace-delimited word before the cursor.
    set keymap vi-command
    Control-l: clear-screen
    Control-w: unix-word-rubout
    set keymap vi-insert
    Control-l: clear-screen
    Control-w: unix-word-rubout
$endif

set skip-completed-text on

# enable case-insensitive tab completion
set completion-ignore-case on

# expand tilde (~) to fullpath
set expand-tilde on

# disable pagination of possible completions
set page-completions off

set print-completions-horizontally on

set mark-directories on

set mark-symlinked-directories on

# disable completions for match hidden files unless pattern begins with a dot
set match-hidden-files off

$if Bash
    Tab: complete
    Space: magic-space
$endif
