#!/bin/bash
#
# Usage: udict word...
set -eo pipefail

if [ $# -eq 0 ]; then
	echo >&2 "usage: $(basename "$0") word..."
	exit 2
fi

# jq -e exits non-zero when the result set is empty, which is how a
# missing definition is distinguished from a transport error.
if ! defs=$(curl -fsSL -G \
	--data-urlencode "term=$*" \
	'https://api.urbandictionary.com/v0/define?page=1' |
	jq -e -r '.list[] | .permalink, .definition'); then
	echo >&2 "$(basename "$0"): no definitions found for $*"
	exit 1
fi

printf '%s\n' "$defs" | col -x | fmt -w 72 | less -X
